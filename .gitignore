# Deny by default. Only the framework is visible to git.
# Anything else dropped in this checkout (real bot configs, scratch,
# agent state, probe notes, CONTEXT.md) stays out.

/*
!/.gitignore
!/README.md
!/install.sh
!/uninstall.sh
!/LICENSE
!/LICENSE.md

!/docs/
!/hooks/
!/lib/
!/scripts/
!/skills/
!/templates/
!/bots/

# bots/ is the exception inside the exception: real configs live here,
# and only the template is framework.
/bots/*
!/bots/.gitignore
!/bots/example.conf
